# Local configuration only. Do not paste secrets into chat or commit .env.
LLM_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90

# Optional real semantic retrieval; same-origin LLM key fallback is supported.
EMBEDDING_BASE_URL=https://api.deepinfra.com/v1/openai
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
# Live RAG draft + same-model review share the total budget (Compose uses 60/120).
RAG_TIMEOUT_SECONDS=60
RAG_TOTAL_SECONDS=120

# Workspace Agent: actual loopback HTTP retrieval; change this port with your worker.
LABLENS_AGENT_TOOL_BASE_URL=http://127.0.0.1:8765
LABLENS_AGENT_TOTAL_SECONDS=75
# Conservative serialized-byte estimate plus framing and output reserve; not a
# tokenizer measurement or a claim about the provider's advertised window.
LABLENS_CONTEXT_WINDOW_TOKENS=65536

# Export this variable when starting the JVM directly; Compose also uses 150.
# JVM does not read .env automatically. Its task lease defaults to 180 seconds.
LABLENS_WORKER_TIMEOUT_SECONDS=150

# Active = QUEUED + RUNNING + CANCEL_REQUESTED. All JVMs sharing one database
# must use the same limits. Direct JVM startup requires exported variables;
# compose.yaml forwards these three values into workspace.environment.
LABLENS_MAX_PENDING_GLOBAL=1000
LABLENS_MAX_PENDING_TASKS=200
# New attempts per workspace / 60 seconds, not model tokens or accepted tasks.
# <=0 explicitly disables Redis admission. With it enabled, Redis failure rejects
# new provider-capable tasks; offline BM25/extractive still uses MySQL capacity.
LABLENS_RATE_LIMIT=120

# Docker Compose only: choose local passwords before starting MySQL.
LABLENS_DB_PASSWORD=
LABLENS_MYSQL_ROOT_PASSWORD=

# Optional MQ overlay: compose.mq.yaml. Main Compose and direct JVM default off.
LABLENS_MQ_ENABLED=false
LABLENS_MQ_HOST=127.0.0.1
LABLENS_MQ_PORT=5673
LABLENS_MQ_USERNAME=lablens
LABLENS_MQ_PASSWORD=
LABLENS_MQ_VHOST=lablens
