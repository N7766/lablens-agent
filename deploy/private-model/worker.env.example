# Candidate only. Copy to an ignored private path; do not use the main .env.
# The deployment guide starts this under env -i and explicitly exports every line.
# Only the gateway owns the upstream key and SSH-tunnel endpoint (18080).
# Set this worker key to the local gateway caller key, never the upstream key.
LLM_BASE_URL=http://127.0.0.1:18081/v1
LLM_MODEL=lablens-private
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=40
LABLENS_REVIEW_PROTOCOL=scoped-review-decisions-v4
PYTHON_DOTENV_DISABLED=1

# Round19 uses BM25 only. A separate, closed loopback origin prevents the
# same-origin LLM-key fallback in rag.provider_config from authorizing embeddings.
# Empty values are deliberately exported so load_dotenv cannot import old keys.
EMBEDDING_BASE_URL=http://127.0.0.1:9
EMBEDDING_MODEL=disabled-round19-bm25-only
EMBEDDING_API_KEY=
EMBEDDING_MODEL_REVISION=
EMBEDDING_BATCH_SIZE=1
RAG_TIMEOUT_SECONDS=40
RAG_TOTAL_SECONDS=80

# Isolated worker, independent of the main service on 8765.
LABLENS_AGENT_TOOL_BASE_URL=http://127.0.0.1:8770
LABLENS_AGENT_TOTAL_SECONDS=80
# Conservative UTF-8-byte/framing units, not tokenizer measurements.
LABLENS_CONTEXT_WINDOW_TOKENS=32768
LABLENS_AUTH_ENABLED=true
LABLENS_SERVICE_KEY=
LABLENS_CHECKPOINT_BASE_URL=
LABLENS_CHECKPOINTS_ENABLED=false
LABLENS_INDEX_DB=
LABLENS_INDEX_MAX_ENTRIES=128
